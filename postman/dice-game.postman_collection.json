{
  "info": {
    "name": "Dice Game API",
    "description": "HTTP API of the dice game. Run the whole collection against `docker compose up` (DEV_MODE=true). The Setup folder settles open plays and resets balances, so the collection can run any number of times.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"has X-Request-Id header\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.be.a(\"string\").and.not.empty);",
          "if (pm.response.code >= 400) {",
          "  pm.test(\"error format\", () => {",
          "    const error = pm.response.json().error;",
          "    pm.expect(error.code).to.be.a(\"string\");",
          "    pm.expect(error.message).to.be.a(\"string\");",
          "    pm.expect(error.requestId).to.eql(pm.response.headers.get(\"X-Request-Id\"));",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "playKey",
      "value": ""
    },
    {
      "key": "reusedKey",
      "value": ""
    },
    {
      "key": "balanceBefore",
      "value": ""
    },
    {
      "key": "balanceAfter",
      "value": ""
    },
    {
      "key": "playId",
      "value": ""
    },
    {
      "key": "rolled",
      "value": ""
    },
    {
      "key": "payout",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "End open play (gandalf)",
          "request": {
            "method": "POST",
            "header": [
