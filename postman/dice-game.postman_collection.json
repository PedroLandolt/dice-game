    {
      "name": "1. Happy path (gandalf)",
      "item": [
        {
          "name": "Wallet before",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{gandalfToken}}"
              }
            ],
            "url": "{{baseUrl}}/v1/clients/gandalf/wallet"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"no open play\", () => pm.expect(body.openPlay).to.eql(null));",
                  "pm.test(\"currency EUR\", () => pm.expect(body.currency).to.eql(\"EUR\"));",
                  "pm.collectionVariables.set(\"balanceBefore\", body.balance);"
                ]
              }
            }
          ]
        },
        {
          "name": "Play 500 on even",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{gandalfToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{playKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/clients/gandalf/play",
            "body": {
              "mode": "raw",
              "raw": "{\"amount\":500,\"type\":\"even\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"playKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const before = Number(pm.collectionVariables.get(\"balanceBefore\"));",
                  "pm.test(\"rolled 1..6\", () => pm.expect(body.rolled).to.be.within(1, 6));",
                  "pm.test(\"result matches the roll\", () => pm.expect(body.result).to.eql(body.rolled % 2 === 0 ? \"win\" : \"lose\"));",
                  "pm.test(\"payout is 2x on win, 0 on lose\", () => pm.expect(body.payout).to.eql(body.result === \"win\" ? 1000 : 0));",
                  "pm.test(\"bet was debited\", () => pm.expect(body.balance).to.eql(before - 500));",
                  "pm.collectionVariables.set(\"playId\", body.playId);",
                  "pm.collectionVariables.set(\"rolled\", body.rolled);",
                  "pm.collectionVariables.set(\"payout\", body.payout);"
                ]
              }
            }
          ]
        },
        {
          "name": "Play again with the same key (idempotent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{gandalfToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{playKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/clients/gandalf/play",
            "body": {
              "mode": "raw",
              "raw": "{\"amount\":500,\"type\":\"even\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"same play, dice not rolled again\", () => {",
                  "  pm.expect(body.playId).to.eql(pm.collectionVariables.get(\"playId\"));",
                  "  pm.expect(body.rolled).to.eql(Number(pm.collectionVariables.get(\"rolled\")));",
                  "});",
                  "pm.test(\"not debited twice\", () => pm.expect(body.balance).to.eql(Number(pm.collectionVariables.get(\"balanceBefore\")) - 500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wallet shows the open play",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{gandalfToken}}"
              }
            ],
            "url": "{{baseUrl}}/v1/clients/gandalf/wallet"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"open play is the one just made\", () => pm.expect(pm.response.json().openPlay.playId).to.eql(pm.collectionVariables.get(\"playId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "End play",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{gandalfToken}}"
              }
            ],
            "url": "{{baseUrl}}/v1/clients/gandalf/end-play"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const payout = Number(pm.collectionVariables.get(\"payout\"));",
                  "pm.test(\"credited the payout\", () => pm.expect(body.credited).to.eql(payout));",
                  "pm.test(\"final balance = before - bet + payout\", () => pm.expect(body.balance).to.eql(Number(pm.collectionVariables.get(\"balanceBefore\")) - 500 + payout));",
                  "pm.collectionVariables.set(\"balanceAfter\", body.balance);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wallet after",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{gandalfToken}}"
              }
            ],
            "url": "{{baseUrl}}/v1/clients/gandalf/wallet"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"balance matches end play\", () => pm.expect(body.balance).to.eql(Number(pm.collectionVariables.get(\"balanceAfter\"))));",
                  "pm.test(\"no open play\", () => pm.expect(body.openPlay).to.eql(null));"
                ]
              }
            }
          ]
        }
      ]
    },
