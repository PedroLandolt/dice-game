                "key": "Authorization",
                "value": "Bearer {{gandalfToken}}"
              }
            ],
            "url": "{{baseUrl}}/v1/clients/gandalf/end-play"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"settled or nothing to settle\", () => pm.expect(pm.response.code).to.be.oneOf([200, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "End open play (luffy)",
